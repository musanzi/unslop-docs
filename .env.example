# Development stack: compose.dev.yml
API_PORT=8000
WEB_PORT=4200

# PostgreSQL inside Compose. Use localhost only with a separately configured host database.
DB_HOST=db
DB_PORT=5432
DB_USERNAME=unslop-docs
DB_PASSWORD=unslop-docs-local-password
DB_NAME=unslop-docs

# Redis sessions and cache inside Compose
REDIS_URL=redis://redis:6379

# Mailpit catches local email. Inbox: http://localhost:8025
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM="unslop-docs Support <support@unslop-docs.local>"

# Replace with a long random value. SESSION_MAX_AGE is in milliseconds.
SESSION_SECRET=
SESSION_MAX_AGE=86400000

# Google OAuth web client. Set real credentials and the admin's verified Google email.
ADMIN_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/redirect
FRONTEND_URI=http://localhost:4200

# Public profile images only. Compose overrides this with /app/apps/api/uploads.
# Host paths are relative to the API working directory (apps/api).
UPLOADS_DIR=uploads

# Private originals. Compose mounts a separate documents_data volume here.
DOCUMENTS_DIR=private-documents

# Optional contract-generation input. Unset to export the local API schema.
# OPENAPI_INPUT=libs/api-contracts/openapi.json

# Optional process-manager marker read by Angular SSR. Do not set for Compose.
# pm_id=0

# Set by production Docker images for runtime dependencies.
# NODE_ENV=production
