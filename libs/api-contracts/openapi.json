  "info": {
    "title": "unslop-docs API DOC",
    "description": "Google-only sign-in with Redis sessions. Admin access requires the verified Google account configured by ADMIN_EMAIL.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "UserResponse": {
        "type": "object",
        "properties": {
          "isAdmin": {
            "type": "boolean",
            "description": "Admin access derived from the verified Google account and ADMIN_EMAIL",
            "example": false
          },
          "id": {
            "type": "string",
            "example": "b7f2c1e0-4a5d-4c8e-9f1a-2b3c4d5e6f7a"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-09-21T10:00:00.000Z"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-09-21T10:00:00.000Z"
          },
          "email": {
            "type": "string",
            "example": "john.doe@example.com"
          },
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "avatar": {
            "example": "https://example.com/avatar.png",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "roles": {
            "example": [
              "user"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "isAdmin",
          "id",
          "createdAt",
          "updatedAt",
          "email",
          "name",
          "roles"
        ]
      },
      "UpdateProfileDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Alice Student"
          }
        }
      },
      "RoleResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "b7f2c1e0-4a5d-4c8e-9f1a-2b3c4d5e6f7a"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-09-21T10:00:00.000Z"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-09-21T10:00:00.000Z"
          },
          "name": {
            "type": "string",
            "example": "admin"
          }
        },
        "required": [
          "id",
          "createdAt",
          "updatedAt",
          "name"
        ]
      },
      "StatItem": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "example": "users"
          },
          "total": {
            "type": "number",
            "example": 42
          }
        },
        "required": [
          "label",
          "total"
        ]
      }
    }
  }
}
